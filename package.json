{
  "name": "env-validated",
  "version": "1.0.0",
  "description": "Framework-agnostic env var validation with pluggable validators",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/zod": {
      "import": {
        "types": "./dist/adapters/zod.d.ts",
        "default": "./dist/adapters/zod.js"
      },
      "require": {
        "types": "./dist/adapters/zod.d.cts",
        "default": "./dist/adapters/zod.cjs"
      }
    },
    "./adapters/joi": {
      "import": {
        "types": "./dist/adapters/joi.d.ts",
        "default": "./dist/adapters/joi.js"
      },
      "require": {
        "types": "./dist/adapters/joi.d.cts",
        "default": "./dist/adapters/joi.cjs"
      }
    },
    "./adapters/yup": {
      "import": {
        "types": "./dist/adapters/yup.d.ts",
        "default": "./dist/adapters/yup.js"
      },
      "require": {
        "types": "./dist/adapters/yup.d.cts",
        "default": "./dist/adapters/yup.cjs"
      }
    },
    "./adapters/valibot": {
      "import": {
        "types": "./dist/adapters/valibot.d.ts",
        "default": "./dist/adapters/valibot.js"
      },
      "require": {
        "types": "./dist/adapters/valibot.d.cts",
        "default": "./dist/adapters/valibot.cjs"
      }
    },
    "./adapters/typebox": {
      "import": {
        "types": "./dist/adapters/typebox.d.ts",
        "default": "./dist/adapters/typebox.js"
      },
      "require": {
        "types": "./dist/adapters/typebox.d.cts",
        "default": "./dist/adapters/typebox.cjs"
      }
    },
    "./adapters/arktype": {
      "import": {
        "types": "./dist/adapters/arktype.d.ts",
        "default": "./dist/adapters/arktype.js"
      },
      "require": {
        "types": "./dist/adapters/arktype.d.cts",
        "default": "./dist/adapters/arktype.cjs"
      }
    },
    "./adapters/superstruct": {
      "import": {
        "types": "./dist/adapters/superstruct.d.ts",
        "default": "./dist/adapters/superstruct.js"
      },
      "require": {
        "types": "./dist/adapters/superstruct.d.cts",
        "default": "./dist/adapters/superstruct.cjs"
      }
    },
    "./adapters/runtypes": {
      "import": {
        "types": "./dist/adapters/runtypes.d.ts",
        "default": "./dist/adapters/runtypes.js"
      },
      "require": {
        "types": "./dist/adapters/runtypes.d.cts",
        "default": "./dist/adapters/runtypes.cjs"
      }
    },
    "./adapters/effect": {
      "import": {
        "types": "./dist/adapters/effect.d.ts",
        "default": "./dist/adapters/effect.js"
      },
      "require": {
        "types": "./dist/adapters/effect.d.cts",
        "default": "./dist/adapters/effect.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "strip-maps": "node scripts/strip-maps.mjs",
    "prepack": "npm run build && npm run strip-maps"
  },
  "peerDependencies": {
    "@effect/schema": ">=0.67.0",
    "@sinclair/typebox": ">=0.30.0",
    "arktype": ">=2.0.0",
    "effect": ">=3.0.0",
    "joi": ">=17.0.0",
    "runtypes": ">=6.0.0",
    "superstruct": ">=1.0.0",
    "valibot": ">=0.30.0",
    "yup": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/schema": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "joi": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    },
    "arktype": {
      "optional": true
    },
    "superstruct": {
      "optional": true
    },
    "runtypes": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@effect/schema": "^0.75.5",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.5.0",
    "arktype": "^2.2.0",
    "effect": "^3.21.0",
    "joi": "^18.0.2",
    "runtypes": "^7.0.4",
    "superstruct": "^2.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "valibot": "^1.3.1",
    "vitest": "^4.1.0",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "keywords": [
    "env-validated",
    "env",
    "environment",
    "variables",
    "validation",
    "typescript",
    "type-safe",
    "zod",
    "joi",
    "yup",
    "valibot"
  ],
  "license": "MIT",
  "author": "Husain Korasawala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/husainkorasawala/env-validated.git"
  },
  "bugs": {
    "url": "https://github.com/husainkorasawala/env-validated/issues"
  },
  "homepage": "https://github.com/husainkorasawala/env-validated#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
